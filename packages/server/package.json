{
  "name": "@speedcrcpy/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "postinstall": "fetch-scrcpy-server 3.3.4 && node scripts/fetch-ocr-models.mjs"
  },
  "dependencies": {
    "@fails-components/webtransport": "1.6.7",
    "@fails-components/webtransport-transport-http3-quiche": "1.6.7",
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@gutenye/ocr-node": "^1.4.8",
    "@peculiar/x509": "^2.0.0",
    "@speedcrcpy/shared": "workspace:*",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "fastify": "^5.0.0",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "target": "node22",
    "clean": true,
    "noExternal": [
      "@speedcrcpy/shared"
    ]
  }
}
